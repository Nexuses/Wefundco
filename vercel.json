{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "wefundco.com" }],
      "destination": "https://www.wefundco.com/:path*",
      "permanent": true
    },
    {
      "source": "/waitlist-new",
      "destination": "/startups",
      "permanent": true
    },
    {
      "source": "/waitlist",
      "destination": "/startups",
      "permanent": true
    },
    {
      "source": "/blogs",
      "destination": "/resources/blogs",
      "permanent": false
    },
    { "source": "/server.js", "destination": "/", "permanent": false },
    { "source": "/package.json", "destination": "/", "permanent": false },
    { "source": "/package-lock.json", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/startups" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/signup", "destination": "/admin/signup.html" },
    { "source": "/onboarding", "destination": "/onboarding.html" }
  ]
}
