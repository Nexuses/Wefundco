# Copy this file to .env and fill in your values.
# On Vercel, add the same keys in Project Settings → Environment Variables.

MONGODB_URI=
MONGODB_DB=wefundco

Mail_To=
FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

SITE_URL=https://wefundco.com

JWT_SECRET=change-me-to-a-long-random-string

# S3 — onboarding document uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
# Optional CloudFront / custom base (no trailing slash). Defaults to virtual-hosted S3 URL.
# S3_PUBLIC_URL_BASE=https://cdn.example.com
